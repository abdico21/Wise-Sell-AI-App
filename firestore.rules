rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    // User profiles: Users can read and write their own profile
    match /users/{userId} {
      allow get: if isOwner(userId);
      allow list: if isSignedIn();
      allow create, update: if isOwner(userId) && isValidId(userId);
      allow delete: if isOwner(userId);
    }

    // Campaign A/B tests & Performance Advertising
    match /campaign_tests/{testId} {
      allow read: if isSignedIn();
      allow create, update: if isSignedIn() && isValidId(testId);
      allow delete: if isSignedIn();
    }

    // Inventory catalog and parity
    match /inventory/{itemId} {
      allow read: if isSignedIn();
      allow create, update: if isSignedIn() && isValidId(itemId);
      allow delete: if isSignedIn();
    }

    // Social posts & calendar
    match /social_posts/{postId} {
      allow read: if isSignedIn();
      allow create, update: if isSignedIn() && isValidId(postId);
      allow delete: if isSignedIn();
    }

    // Orders & transactions
    match /orders/{orderId} {
      allow read: if isSignedIn();
      allow create, update: if isSignedIn() && isValidId(orderId);
      allow delete: if isSignedIn();
    }

    // Shared business records: every document is scoped to its creating user.
    // Clients must query by ownerId; Firestore enforces ownership on reads and writes.
    match /business_records/{recordId} {
      allow get, list: if isSignedIn() && resource.data.ownerId == request.auth.uid;
      allow create: if isSignedIn()
        && isValidId(recordId)
        && request.resource.data.ownerId == request.auth.uid
        && request.resource.data.recordType in ['customer', 'product', 'lead', 'order']
        && request.resource.data.data is map;
      allow update: if isSignedIn()
        && resource.data.ownerId == request.auth.uid
        && request.resource.data.ownerId == request.auth.uid
        && request.resource.data.recordType == resource.data.recordType
        && request.resource.data.data is map;
      allow delete: if isSignedIn() && resource.data.ownerId == request.auth.uid;
    }

    // Default deny for unmapped paths
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
