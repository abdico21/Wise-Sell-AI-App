rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function owns(userId) { return signedIn() && request.auth.uid == userId; }
    function validListing() {
      return request.resource.data.ownerId == request.auth.uid
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.name.size() <= 160
        && request.resource.data.quantity is number
        && request.resource.data.quantity >= 0
        && request.resource.data.price is number
        && request.resource.data.price >= 0
        && request.resource.data.currency == 'ETB'
        && request.resource.data.status == 'active';
    }
    match /users/{userId}/inventory/{itemId} {
      allow read, delete: if owns(userId);
      allow create, update: if owns(userId)
        && request.resource.data.ownerId == request.auth.uid
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.name.size() <= 160
        && request.resource.data.quantity is number
        && request.resource.data.quantity >= 0
        && request.resource.data.price is number
        && request.resource.data.price >= 0;
    }
    match /marketplace_listings/{listingId} {
      allow read: if resource.data.status == 'active';
      allow create: if signedIn() && validListing();
      allow update: if signedIn() && resource.data.ownerId == request.auth.uid && validListing();
      allow delete: if signedIn() && resource.data.ownerId == request.auth.uid;
    }
    match /marketplace_orders/{orderId} {
      function listingExists() {
        return exists(/databases/$(database)/documents/marketplace_listings/$(request.resource.data.listingId));
      }
      function listingMatches() {
        return listingExists()
          && get(/databases/$(database)/documents/marketplace_listings/$(request.resource.data.listingId)).data.status == 'active'
          && get(/databases/$(database)/documents/marketplace_listings/$(request.resource.data.listingId)).data.ownerId == request.resource.data.sellerId
          && get(/databases/$(database)/documents/marketplace_listings/$(request.resource.data.listingId)).data.name == request.resource.data.itemName
          && get(/databases/$(database)/documents/marketplace_listings/$(request.resource.data.listingId)).data.price == request.resource.data.unitPrice
          && request.resource.data.quantity <= get(/databases/$(database)/documents/marketplace_listings/$(request.resource.data.listingId)).data.quantity;
      }
      allow create: if signedIn()
        && request.resource.data.buyerId == request.auth.uid
        && request.resource.data.sellerId != request.auth.uid
        && request.resource.data.quantity is int
        && request.resource.data.quantity > 0
        && request.resource.data.unitPrice is number
        && request.resource.data.totalPrice == request.resource.data.quantity * request.resource.data.unitPrice
        && request.resource.data.currency == 'ETB'
        && request.resource.data.status == 'pending'
        && listingMatches();
      allow read: if signedIn() && (resource.data.buyerId == request.auth.uid || resource.data.sellerId == request.auth.uid);
      allow update: if signedIn()
        && resource.data.sellerId == request.auth.uid
        && resource.data.status == 'pending'
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'updatedAt'])
        && request.resource.data.status in ['accepted', 'rejected'];
      allow delete: if false;
      match /messages/{messageId} {
        function isOrderParticipant() {
          return signedIn()
            && (get(/databases/$(database)/documents/marketplace_orders/$(orderId)).data.buyerId == request.auth.uid
              || get(/databases/$(database)/documents/marketplace_orders/$(orderId)).data.sellerId == request.auth.uid);
        }
        allow read: if isOrderParticipant();
        allow create: if isOrderParticipant()
          && request.resource.data.senderId == request.auth.uid
          && request.resource.data.text is string
          && request.resource.data.text.size() > 0
          && request.resource.data.text.size() <= 2000;
        allow update, delete: if false;
      }
    }
    match /users/{userId} { allow read, write: if owns(userId); }
    match /{document=**} { allow read, write: if false; }
  }
}