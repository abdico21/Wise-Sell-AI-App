rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    // User profiles: Users can read and write their own profile
    match /users/{userId} {
      allow get: if isOwner(userId);
      allow list: if isSignedIn();
      allow create, update: if isOwner(userId) && isValidId(userId);
      allow delete: if isOwner(userId);
    }

    // Campaign A/B tests & Performance Advertising
    match /campaign_tests/{testId} {
      allow read: if isSignedIn();
      allow create, update: if isSignedIn() && isValidId(testId);
      allow delete: if isSignedIn();
    }

    // Inventory catalog and parity
    match /inventory/{itemId} {
      allow read: if isSignedIn();
      allow create, update: if isSignedIn() && isValidId(itemId);
      allow delete: if isSignedIn();
    }

    // Social posts & calendar
    match /social_posts/{postId} {
      allow read: if isSignedIn();
      allow create, update: if isSignedIn() && isValidId(postId);
      allow delete: if isSignedIn();
    }

    // Orders & transactions
    match /orders/{orderId} {
      allow read: if isSignedIn();
      allow create, update: if isSignedIn() && isValidId(orderId);
      allow delete: if isSignedIn();
    }

    // Default deny for unmapped paths
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
