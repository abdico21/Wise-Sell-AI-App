generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model UserProfile {
  id          String   @id @default(cuid())
  firebaseUid String   @unique
  email       String?
  displayName String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model AiUsageLog {
  id          String   @id @default(cuid())
  firebaseUid String
  feature     String
  createdAt   DateTime @default(now())
  @@index([firebaseUid, createdAt])
}
